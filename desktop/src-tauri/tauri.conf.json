{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Byline",
  "version": "0.1.0",
  "identifier": "io.github.puttosensei.byline",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "node scripts/stage.mjs",
    "beforeDevCommand": "node scripts/stage.mjs"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Byline",
        "url": "byline.html",
        "width": 1280,
        "height": 840,
        "minWidth": 390,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null,
      "freezePrototype": false
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "PuttoSensei",
    "copyright": "Copyright 2026 PuttoSensei",
    "shortDescription": "A signed newsroom",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "windows": {
      "digestAlgorithm": "sha256",
      "signCommand": {
        "cmd": "node",
        "args": [
          "../scripts/sign.mjs",
          "%1"
        ]
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
